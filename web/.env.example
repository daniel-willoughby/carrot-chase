# ============================================================
# Carrot Chase — environment variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ------ Supabase ------
# Found at: Supabase Dashboard → Settings → API

# Public anon key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SECRET, server-side only, never commit
# ROTATE THIS KEY before production if it has ever been shared.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------ Resend (email) ------
# Sign up at https://resend.com → API Keys → Create key
# For production, set RESEND_FROM_EMAIL to a verified domain address.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------ App URL ------
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app  (or custom domain)
# Used to compose invite email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
